#!/bin/sh
# The pre-commit hook make hooks installs (core.hooksPath .githooks):
# refuses a commit whose staged added lines hold a URL (but the toolchain
# target's clone address), an email address but the trailer's, a session
# id, a model name, or a secret (tools/scan_text.sh).
out=$(git diff --cached -U0 --no-color --no-renames --no-ext-diff --no-textconv |
  sh tools/scan_text.sh --diff)
status=$?
[ -z "$out" ] || printf '%s\n' "$out" >&2
[ "$status" -eq 0 ] || {
  echo "pre-commit: the staged lines hold text CLAUDE.md forbids; remove each hit above" >&2
  exit 1
}
